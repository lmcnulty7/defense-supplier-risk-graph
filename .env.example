# Copy to .env (gitignored) and fill in. Never commit real keys.
ANTHROPIC_API_KEY=
SAM_API_KEY=
# Only needed for `make feed-snapshot` (refreshing the committed feed snapshot in data/feeds/mena/).
# Relative paths resolve against the repo root.
MENA_RISK_FEED_PATH=
# Optional
# BUDGET_USD=9.00
# AGENT_MODEL=claude-opus-5-5
# AGENT_EFFORT=low
# SAM_DAILY_BUDGET=8
# NEO4J_PASSWORD=
